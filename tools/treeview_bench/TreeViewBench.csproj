<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Console subsystem on purpose: the harness reports numbers on stdout. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>TreeViewBench</AssemblyName>
    <RootNamespace>TreeViewBench</RootNamespace>
    <!-- Stand-alone harness: don't inherit anything from the app's build. -->
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
  </PropertyGroup>

</Project>
