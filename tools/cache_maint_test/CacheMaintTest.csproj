<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Stand-alone: this harness must not inherit src\Directory.Build.props, whose
    <Version> stamps the shipping assemblies. See tools\expand_probe.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <AssemblyName>CacheMaintTest</AssemblyName>
    <RootNamespace>CacheMaintTest</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LithicBackup\LithicBackup.csproj" />
  </ItemGroup>

</Project>
