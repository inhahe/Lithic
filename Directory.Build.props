<Project>

  <!--
    Settings for every project in the repository: the product (src\, whose own
    Directory.Build.props imports this one), the test harnesses (tools\) and the
    installer's custom action.

    NU1603: a package's dependency was not found at the version asked for, and
    NuGet quietly took a higher one. That is how a stale HTTP cache once paired
    Microsoft.Data.Sqlite 8.0.33 with Microsoft.Data.Sqlite.Core 9.0.0, another
    major version, with only a warning (known-issues.md). As an error, a restore
    that cannot get the versions asked for stops instead of building something
    else. Clearing NuGet's HTTP cache and restoring again fixes a stale listing;
    known-issues.md has the command (an XML comment cannot hold its double hyphen).
  -->
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);NU1603</WarningsAsErrors>
  </PropertyGroup>

</Project>
