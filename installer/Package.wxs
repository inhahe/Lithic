<?xml version="1.0" encoding="UTF-8"?>
<!--
  LithicBackup installer (WiX Toolset v4+ / built with the `wix` dotnet tool).

  Produces a per-machine MSI that:
    * installs the self-contained GUI + Worker into "Program Files\Lithic Backup"
      (no .NET runtime prerequisite — the publish output is self-contained),
    * installs and starts the "Lithic Backup" Windows service (the Worker), so the
      background backup engine is ready out of the box,
    * adds a Start Menu shortcut for the GUI, and
    * registers a normal Add/Remove Programs uninstaller that stops + removes the
      service and deletes all installed files.

  Build inputs live in .\publish (populated by build-installer.ps1 via
  `dotnet publish`).  Version is passed in with `-d Version=x.y.z`.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <?define Version = "$(var.Version)" ?>

  <Package
      Name="Lithic Backup"
      Manufacturer="Lithic"
      Version="$(Version)"
      UpgradeCode="7BC4E6C1-51A6-4D2C-9936-20C21DC77254"
      Scope="perMachine"
      Compressed="yes">

    <!-- Block same/older reinstalls with a clear message; allow upgrades. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of Lithic Backup is already installed." />

    <!--
      Close the running GUI BEFORE Windows Installer's file-in-use check — by
      ASKING it to exit itself, not by killing it.

      Background: LithicBackup.exe is an interactive tray app.  On a plain
      WM_CLOSE it minimizes to the tray instead of exiting, and because
      ShutdownMode is OnExplicitShutdown the process (and its locked .exe) stays
      alive.  Mechanisms we tried and rejected:
        * Restart Manager / util:CloseApplication only *ask the window* to close
          (WM_QUERYENDSESSION / WM_ENDSESSION).  The main window is hidden in the
          tray, so RM often can't message it, and the WndProc-cooperation path
          proved unreliable.  Its terminate fallback (WixCloseApplications) is
          also scheduled AFTER InstallValidate, too late to prevent the dialog.
        * taskkill /F before InstallValidate.  This works only when the installer
          action outranks the GUI: if the user runs the GUI ELEVATED (High
          integrity), the pre-InstallValidate action — which runs at the invoking
          user's Medium integrity for a double-clicked per-machine MSI — gets
          Access Denied and cannot kill it (UIPI).  That failure is exactly what
          drove the whole "unable to close" saga.

      The reliable, elevation-free fix: the installer SIGNALS the GUI over a
      simple IPC handshake and the GUI closes ITSELF.  A process can always shut
      itself down regardless of integrity level, so nothing needs to out-rank the
      elevated GUI.  The managed custom action SignalLithicGuiShutdown (see the
      Binary + CustomAction near the bottom of this file, and installer\
      CustomActions\CustomAction.cs) sets a named event the GUI listens on
      (App.xaml.cs, "LithicBackup.Shutdown"), then waits for LithicBackup.exe to
      exit — all BEFORE InstallValidate, so by the file-in-use check the .exe is
      already released.  No taskkill, no elevation, no self-elevating bundle, and
      no forced reboot.  (Bootstrap note: this only helps once the *running* build
      already contains the listener; the upgrade that first delivers it still
      relies on the in-app updater closing the old GUI itself — the wait in the
      custom action removes that race — or on the user closing it manually.)
    -->

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="publish\LithicBackup.exe" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/" />

    <!-- Install location: 64-bit Program Files. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Lithic Backup" />
    </StandardDirectory>

    <!-- Start Menu folder for the app shortcut. -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppShortcutFolder" Name="Lithic Backup" />
    </StandardDirectory>

    <!--
      Bulk-harvest every published file EXCEPT the Worker executable, which is
      installed by its own component (below) so a ServiceInstall can be attached.
    -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="publish\**">
        <Exclude Files="publish\LithicBackup.Worker.exe" />
        <Exclude Files="publish\LithicBackup.exe" />
      </Files>
    </ComponentGroup>

    <!--
      The GUI executable, installed by its own component so it has a stable File
      Id ("AppExe") that the "Launch Lithic Backup" custom action can reference
      via [#AppExe] (resolves to the full install path at runtime).
    -->
    <Component Id="AppExeComponent"
               Directory="INSTALLFOLDER"
               Guid="4B0F2E7A-9C1D-4E5B-8A62-1F3C7D9A4E80"
               Bitness="always64">
      <File Id="AppExe" Source="publish\LithicBackup.exe" KeyPath="yes" />
    </Component>

    <!--
      The Worker executable + the Windows service it backs.  The service runs as
      LocalSystem (matching the app's own sc.exe install) so it shares the
      ProgramData catalog with the interactive GUI.  Started on install; stopped
      and removed on uninstall.
    -->
    <Component Id="WorkerService"
               Directory="INSTALLFOLDER"
               Guid="DD535A49-6F70-48E7-926D-7149ED93F0A0"
               Bitness="always64">
      <File Id="WorkerExe" Source="publish\LithicBackup.Worker.exe" KeyPath="yes" />

      <ServiceInstall Id="WorkerServiceInstall"
                      Name="Lithic Backup"
                      DisplayName="Lithic Backup Worker"
                      Description="Runs scheduled and on-demand Lithic Backup backups in the background."
                      Type="ownProcess"
                      Start="auto"
                      ErrorControl="normal"
                      Account="LocalSystem"
                      Vital="no" />

      <!--
        Stop the running Worker on BOTH install and uninstall, and wait for it to
        fully stop.  Remove happens only on uninstall.

        NOTE what this does NOT do: it does not prevent the "setup was unable to
        automatically close all requested applications" dialog (error 1611).
        ServiceControl runs at StopServices (sequence 1900), 500 steps AFTER
        InstallValidate (1400), which is where the file-in-use check happens — so
        at the moment that check runs, the service is still up and still holding
        LithicBackup.Worker.exe and every self-contained DLL it loaded from this
        folder.  Passing the check is the job of the SignalLithicShutdown custom
        action below, which is sequenced Before InstallValidate.

        This element still earns its place: it keeps the service stopped for the
        duration of the file transfer (so nothing restarts it mid-copy) and
        unregisters it on uninstall.
      -->
      <ServiceControl Id="WorkerServiceStopRemove"
                      Name="Lithic Backup"
                      Stop="both"
                      Remove="uninstall"
                      Wait="yes" />

      <!-- Start (or restart) on install, after the stop above has completed. -->
      <ServiceControl Id="WorkerServiceStart"
                      Name="Lithic Backup"
                      Start="install"
                      Wait="no" />
    </Component>

    <!-- Start Menu shortcut for the GUI. -->
    <Component Id="AppShortcut"
               Directory="AppShortcutFolder"
               Guid="C96CEDA6-142F-4896-904C-34EA8C8466B1"
               Bitness="always64">
      <Shortcut Id="StartMenuShortcut"
                Name="Lithic Backup"
                Description="Disc and directory backup"
                Target="[INSTALLFOLDER]LithicBackup.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveAppShortcutFolder" Directory="AppShortcutFolder" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\Lithic\LithicBackup"
                     Name="installed"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <!--
      Remove the WER LocalDumps registration on uninstall.

      Both executables register themselves at startup under
      HKLM\SOFTWARE\Microsoft\Windows\Windows Error Reporting\LocalDumps\<image>.exe
      (see Diagnostics.NativeCrashDumps) so that native crashes leave a .dmp
      behind. Nothing ever removed them again, so uninstalling left two
      machine-wide keys pointing a dump policy at executables that no longer
      exist - and at a DumpFolder under ProgramData that the user may well have
      deleted. Harmless day to day, but it is litter in an OS key, and if any
      other program ever shipped an executable with the same name it would
      silently inherit this dump configuration.

      That key is full of exactly this kind of debris from other uninstalled
      software, which is the argument for not adding to it.

      ForceDeleteOnUninstall removes the key and everything under it. The
      component is KeyPath'd on a value of our own so the installer has
      something to reference-count; it is deliberately under our own
      SOFTWARE\Lithic key rather than inside the WER key, so removing it can
      never take neighbouring registrations with it.
    -->
    <Component Id="WerLocalDumpsCleanup"
               Directory="INSTALLFOLDER"
               Guid="213D9A78-B9DE-48FC-A484-64C2099054BC"
               Bitness="always64">
      <RegistryKey Root="HKLM"
                   Key="SOFTWARE\Microsoft\Windows\Windows Error Reporting\LocalDumps\LithicBackup.exe"
                   ForceDeleteOnUninstall="yes" />
      <RegistryKey Root="HKLM"
                   Key="SOFTWARE\Microsoft\Windows\Windows Error Reporting\LocalDumps\LithicBackup.Worker.exe"
                   ForceDeleteOnUninstall="yes" />
      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\Lithic\LithicBackup"
                     Name="werLocalDumpsRegistered"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="Lithic Backup" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="AppExeComponent" />
      <ComponentRef Id="WorkerService" />
      <ComponentRef Id="AppShortcut" />
      <ComponentRef Id="WerLocalDumpsCleanup" />
    </Feature>

    <!-- Classic install wizard with directory chooser + license page. -->
    <ui:WixUI xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
              Id="WixUI_InstallDir"
              InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <!--
      Offer to launch the GUI from the final wizard page.  Uses the WixUI exit
      dialog's built-in optional checkbox (checked by default), wired to a
      WixShellExec custom action that starts LithicBackup.exe.  Impersonate="yes"
      so the app runs as the installing user, not the elevated installer account;
      asyncNoWait so the wizard closes immediately without blocking on the app.

      Why this never launches after a FAILED/CANCELLED install:
        * WixUI routes outcomes to different dialogs - success -> ExitDialog
          (this one), user cancel -> UserExit, fatal error/rollback -> FatalError.
          Only ExitDialog carries the launch checkbox + DoAction, so a cancel or
          a rolled-back install can't reach this launch at all.
        * The one path that could once show ExitDialog with the app NOT actually
          updated was "files in use -> user declines to close -> file swap
          deferred to the next reboot -> transaction succeeds with a reboot
          pending", which then offered to launch the still-old exe.  We remove
          that path at the source: the SignalLithicGuiShutdown custom action asks
          the GUI to close before InstallValidate, so (once the running build has
          the listener) nothing is ever in use and no reboot is ever scheduled -
          ExitDialog therefore only appears after a genuinely complete install.

      Conditions on the launch:
        * WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1  - the user left the box ticked.
        * NOT Installed                         - a first-time install or a
          major upgrade (the new package is not yet registered), never a repair,
          modify, or uninstall.
    -->
    <!--
      Ask BOTH holders of the install folder — the GUI and the Worker service —
      to close themselves before the file-in-use check.

      Managed (DTF) custom action, built by installer\CustomActions and embedded
      as the LithicCustomActions binary.  SignalLithicShutdown sets the named
      event each process listens on (Global\LithicBackup.Shutdown for the GUI,
      falling back to the session-local LithicBackup.Shutdown, see
      src\LithicBackup\App.xaml.cs; Global\LithicBackup.Worker.Shutdown for the
      service, see src\LithicBackup.Worker\ShutdownSignalListener.cs) and waits,
      bounded and concurrently, for both processes to exit.

      WHAT ACTUALLY BROKE IT — and it is not in this file.  From 1.0.11 to 1.0.55
      this action never executed a single line.  installer\CustomActions had no
      CustomAction.config, so SfxCA.dll (the native stub around a DTF action,
      which must choose a CLR before it can load any managed code) bound
      CLR v2.0.50727 and threw BadImageFormatException on the net472 assembly.
      Return="ignore" turned that 1603 into "success", and the install walked
      straight into the 1611 this action exists to prevent.  If you ever see
      "SFXCA: Binding to CLR version v2.0.50727" in a verbose log, that config
      file has gone missing again.

      WHICH PROCESS THIS RUNS IN.  Stated from measurement, because a
      plausible-sounding guess about this once sent the diagnosis badly astray:
      for an ordinary double-click it runs as a REMOTE custom action hosted in
      rundll32, IMPERSONATED AS THE INVOKING USER IN THAT USER'S OWN SESSION.
      The action logs this on every run, e.g. "running as 'DOMAIN\user' in
      process rundll32 (pid 72736), session 1."  It does NOT run as LocalSystem
      in session 0 — an earlier revision of this very comment asserted that, and
      it was wrong.  Consistent with the measurement, it cannot SCM-stop the
      LocalSystem service ("Cannot open Lithic Backup service on computer '.'"),
      which is why the Worker is asked via its Global\ event instead.

      Scheduled Before InstallValidate (see InstallExecuteSequence below) so both
      executables and all their self-contained DLLs are released before MSI looks
      for open files.  This — not the ServiceControl element above — is what
      prevents the "unable to automatically close all requested applications"
      dialog (error 1611): ServiceControl runs at StopServices (1900), while the
      check runs at InstallValidate (1400).

        * Execute="immediate"  — runs during sequence processing, before the
          file-in-use detection; a deferred action would run far too late.
        * Impersonate="yes"    — runs as the invoking user, which is what puts the
          action in that user's session and namespace (confirmed by its own log).
          The action ASKS both processes to exit rather than killing them because
          a process can always shut itself down regardless of integrity level,
          which is the only approach that works against a GUI running elevated.
        * Return="ignore"      — this is a best-effort convenience; the action also
          returns Success internally.  A first-time install (nothing running) is a
          harmless no-op.  NOTE that this is also what hid a custom action that
          could not even LOAD for 45 releases, which is why the action now logs
          the process, account and session it is running in — and why a verbose
          log should be checked for "SignalLithicShutdown:" lines after any change
          to the CustomActions project.

      No condition: attempting the signal on every install/upgrade/uninstall is
      harmless (a no-op when nothing is running) and keeps behavior predictable.

      Bootstrap caveat: an upgrade can only signal a listener the ALREADY-INSTALLED
      build contains.  The upgrade that first delivers a listener still falls back
      to Windows Installer's own handling for that one process.  That fallback
      (Restart Manager) closes an ordinary unelevated GUI fine; it cannot close an
      elevated one, because UIPI blocks the unelevated client from posting to a
      High-integrity window.
    -->
    <Binary Id="LithicCustomActions"
            SourceFile="CustomActions\bin\Release\LithicBackup.CustomActions.CA.dll" />

    <CustomAction Id="SignalLithicShutdown"
                  BinaryRef="LithicCustomActions"
                  DllEntry="SignalLithicShutdown"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="SignalLithicShutdown" Before="InstallValidate" />
    </InstallExecuteSequence>

    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Lithic Backup" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#AppExe]" />
    <CustomAction Id="LaunchApplication"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixShellExec"
                  Impersonate="yes" />

    <UI>
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed and NOT REMOVE" />
    </UI>

  </Package>
</Wix>
