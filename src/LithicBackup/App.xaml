<Application x:Class="LithicBackup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:LithicBackup.Converters"
             ShutdownMode="OnExplicitShutdown"
>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml" />
                <!-- Flow view model -> view mapping, reachable from every window
                     (the main window, the set editor, and each TaskWindow). -->
                <ResourceDictionary Source="Resources/FlowViewTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global converters -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
            <converters:FileSizeConverter x:Key="FileSize" />
            <converters:DepthToIndentConverter x:Key="DepthToIndent" />
            <converters:IntEqualsVisibilityConverter x:Key="IntEqualsVis" />
            <converters:NonEmptyStringToVisibilityConverter x:Key="NonEmptyVis" />
            <converters:FractionOfConverter x:Key="FractionOf" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
