<Window x:Class="LithicBackup.Views.BackupSetEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LithicBackup.ViewModels"
        xmlns:views="clr-namespace:LithicBackup.Views"
        Style="{StaticResource MainWindowStyle}"
        Title="Modify Backup Set"
        Icon="/Assets/LithicBackup.ico"
        Height="950" Width="950"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Opacity="0">

    <Border Style="{StaticResource Card}" Margin="12">
        <!-- Templates come from Resources/FlowViewTemplates.xaml via the
             application resources, so this window no longer needs its own copy
             of the mapping (and can no longer drift from the main window's). -->
        <ContentControl x:Name="ContentArea" Focusable="False" />
    </Border>
</Window>
